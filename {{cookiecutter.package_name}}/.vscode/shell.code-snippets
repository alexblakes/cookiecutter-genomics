	"Shell script template": {
		"scope": "shellscript",
		"prefix": [
			"sh",
			"shell",
			"bash",
		],
		"description": "Shell script template",
		"body": [
			"#!/usr/bin/env bash",
			"# ${1:Script docstring}",
			"",
			"set -eu",
			"",
			"source src/utils.sh # _log",
			"",
			"FILE_IN=\\${1:-''}",
			"FILE_OUT=\\${2:-''}",
			"",
			"tmpdir=\\$(mktemp -d)",
			"trap 'rm -rf \"\\$tmpdir\"' EXIT",
			"",
			"wait"
		],
	},
	"LSF job script": {
		"scope": "shellscript",
		"prefix": [
			"lsf",
			"bsub",
		],
		"description": "LSF job script template (supports job arrays)",
		"body": [
			"#!/usr/bin/env bash",
			"#BSUB -q inter",
			"#BSUB -P re_gecip_enhanced_interpretation",
			"#BSUB -o ${1:logs}/${2:job_name}/%J.%I.out",
			"#BSUB -e ${1:logs}/${2:job_name}/%J.%I.err",
			"#BSUB -J ${2:job_name}",
			"#BSUB -R \"rusage[mem=1G] span[hosts=1]\"",
			"#BSUB -M 1G",
			"#BSUB -n 1",
			"#BSUB -cwd .",
			"",
			"set -euo pipefail",
			"",
			"# Set environment",
			"# source activate <conda_env>",
			"# module load <module_name>",
			"",
			"export TMPDIR=\"/re_scratch/re_gecip/enhanced_interpretation/ablakes/${2:job_name}\"",
			"mkdir -p \"\\$TMPDIR\"",
			"",
			"# Get variables from a file - one per job.",
			"# If LSB_JOBINDEX is zero (in non-array jobs) or unset, assign a default value of 1.",
			"# LSB_JOBINDEX could also be set as an environment variable at the command line.",
			"[[ -z \"\\${LSB_JOBINDEX:-}\" || \"\\$LSB_JOBINDEX\" == 0 ]] && LSB_JOBINDEX=1",
			"",
			"LIST_FILE=\\${1:-}",
			"if [[ -n \\$LIST_FILE ]]; then",
			"  var=\\$(< \"\\$LIST_FILE\" awk -v ix=\"\\${LSB_JOBINDEX}\" 'NR==ix')",
			"fi",
			"",
		],
	}
}